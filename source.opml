				<outline text="### Example 0">
					<outline text="An untitled &lt;a href=&quot;http://scripting.com/2024/03/31.html#a164241&quot;&gt;blog post&lt;/a&gt; from March 31, 2024, explaining how I had been using OPML to write and archive my blog writing starting in 2017.   ">
					</outline>
					<outline text="&lt;img src=&quot;screenshots/example0.png&quot;&gt;">
					</outline>
				</outline>
				<outline text="### Example 1">
					<outline text="A &lt;a href=&quot;http://scripting.com/2024/03/05/200550.html&quot;&gt;titled blog post&lt;/a&gt; from March 5, 2024 about some of my discoveries in creating art with ChatGPT.">
					</outline>
					<outline text="&lt;img src=&quot;screenshots/example1.png&quot;&gt;">
					</outline>
				</outline>
				<outline text="### Example 2">
